---
import { Image } from 'astro:assets'
import Layout from '../layouts/Layout.astro'
import { Icon } from 'astro-icon/components'
import { getNavLink, getPostLink } from '../lib/blog-helpers.ts'
import { getPosts } from '../lib/notion/client.ts'
import { getListingLibraries } from '../lib/notion/libraries.ts'
import StickerBoard from '../components/StickerBoard.astro'
import cover from '../assets/cover.jpg'
import logo from '../assets/logo.png'

const recentPosts = await getPosts(6)
const libraries = await getListingLibraries()
---

<Layout bare path="/">
  <div slot="main" class="notebook">
    <div class="cover">
      <Image
        src={cover}
        alt=""
        widths={[800, 1200, 1600, 2400]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <div class="sheet">
      <Image
        class="page-icon"
        src={logo}
        alt=""
        width={96}
        height={96}
        densities={[1, 2]}
        loading="eager"
      />
      <h1>七罪的手账本。</h1>
      <p class="motto">La vida no tiene precio.</p>

      <div class="pinboard">
        <section class="card card-posts" aria-label="最近更新">
          <h2>文章</h2>
          {
            recentPosts.length > 0 ? (
              <ul>
                {recentPosts.map((post) => (
                  <li>
                    <a href={getPostLink(post.Slug)}>{post.Title}</a>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="empty">还没有写下的东西。</p>
            )
          }
          <a class="more" href={getNavLink('/posts')}>全部文章 →</a>
        </section>

        {
          libraries.length > 0 && (
            <div class="library-stack">
              {libraries.map((library) => (
                <a class="card card-library" href={getNavLink(library.Path)}>
                  <h2>{library.Name}</h2>
                  {library.Description && <p>{library.Description}</p>}
                  <span class="more">翻开清单 →</span>
                </a>
              ))}
            </div>
          )
        }
      </div>

      <nav class="entries" aria-label="相关入口">
        <a href={getNavLink('/posts')}>
          <Icon name="ph:article-light" aria-hidden="true" />
          仓库
        </a>
        <a
          href="https://github.com/Tanya7z"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="ph:github-logo-light" aria-hidden="true" />
          GitHub
        </a>
        <a href="mailto:hi@ovo7.cc">
          <Icon name="ph:envelope-simple-light" aria-hidden="true" />
          hi@ovo7.cc
        </a>
        <a
          href="https://space.bilibili.com/455301292"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="ph:television" aria-hidden="true" />
          Bilibili
        </a>
      </nav>

      <StickerBoard collection="首页" label="首页贴画" layout="scatter" />
    </div>
  </div>
</Layout>

<style>
  .notebook {
    min-height: 100vh;
    /* 贴纸可以探出纸边甚至被窗口裁掉一角，但不能把整页撑出横向滚动条 */
    overflow-x: clip;
    /* 封面高度 */
    --cover-height: min(38vh, 280px);
    /* 封面焦点 */
    --cover-position: center 25%;
  }

  .cover {
    width: 100%;
    height: var(--cover-height);
    overflow: hidden;
    background: #3a2a22;
  }

  .cover :global(picture),
  .cover :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .cover :global(img) {
    object-fit: cover;
    object-position: var(--cover-position);
  }

  .sheet {
    /* 首页散落贴画以此为定位参照 */
    position: relative;
    width: min(100%, 720px);
    margin: 0 auto;
    padding: 0 28px 96px;
  }

  .sheet :global(.page-icon) {
    display: block;
    width: 96px;
    height: 96px;
    margin-top: -48px;
    object-fit: contain;
    background: transparent;
  }

  h1 {
    margin: 18px 0 0;
    font-size: clamp(2rem, 4vw, 2.55rem);
    letter-spacing: 0.01em;
  }

  .motto {
    margin: 8px 0 0;
    color: var(--muted);
    font-style: normal;
    font-size: 1rem;
  }

  .entries {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 8px;
    margin-top: 22px;
  }

  .entries a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    color: var(--muted);
    font-size: 14px;
    text-decoration: none;
    border-radius: 4px;
  }

  .entries a:hover {
    color: var(--ink);
    background: var(--soft);
    text-decoration: none;
  }

  .entries img,
  .entries svg {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
  }

  .entries img {
    object-fit: contain;
  }

  /* ===== 扉页拼贴板 ===== */
  .pinboard {
    --pinboard-gap: 1.6rem;
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    align-items: stretch;
    gap: var(--pinboard-gap);
    margin-top: 2.6rem;
  }

  /* 清单卡叠在文章右侧，整列拉到与文章卡同高，空隙均分到各卡之间 */
  .library-stack {
    display: flex;
    flex-direction: column;
    gap: var(--pinboard-gap);
    min-width: 0;
  }

  .card {
    position: relative;
    display: block;
    border: 1px solid var(--line);
    padding: 1.2rem 1.3rem 1.4rem;
    background: var(--paper);
    color: inherit;
    text-decoration: none;
  }

  .card h2 {
    margin: 0 0 0.8rem;
    color: var(--muted);
    font-family: var(--font-display);
    font-style: normal;
    font-size: 1.4rem;
  }

  /* 纸堆叠：两层错开并微微歪斜的伪元素垫在卡片下面 */
  .card-posts::before,
  .card-posts::after {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    border: 1px solid var(--line);
    background: var(--paper);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
  }

  .card-posts::before {
    transform: translate(5px, 5px) rotate(0.5deg);
  }

  .card-posts::after {
    transform: translate(10px, 10px) rotate(1.1deg);
  }

  .card-posts ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card-posts li {
    padding: 0.3rem 0;
    line-height: 1.5;
  }

  .card-posts .empty {
    margin: 0;
    color: var(--muted);
  }

  .card-library {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
  }

  .card-library p {
    margin: 0;
    color: var(--muted);
    font-size: 1.15rem;
    line-height: 1.6;
  }

  .card-library .more {
    margin-top: auto;
    padding-top: 0.9rem;
  }

  .card-library:hover {
    background: var(--soft);
  }

  .more {
    display: inline-block;
    margin-top: 0.9rem;
    color: var(--muted);
    font-size: 1.05rem;
    text-decoration: none;
  }

  .more:hover {
    color: var(--ink);
  }

  @media (max-width: 640px) {
    .pinboard {
      --pinboard-gap: 2rem;
      grid-template-columns: 1fr;
    }

    .cover {
      height: 180px;
    }

    .sheet {
      padding: 0 20px 72px;
    }

    .sheet :global(.page-icon) {
      width: 78px;
      height: 78px;
      margin-top: -39px;
    }
  }
</style>
