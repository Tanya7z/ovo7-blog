---
import Layout from '../layouts/Layout.astro'
import CollageBoard from '../components/CollageBoard.astro'
import StickerBoard from '../components/StickerBoard.astro'
import {
  EXPLORE_LIBRARY_NAME,
  EXPLORE_LIBRARY_SLUG,
  getListingLibraries,
  groupByCollection,
} from '../lib/notion/libraries.ts'

const libraries = await getListingLibraries()
const explore =
  libraries.find(
    (library) =>
      library.Name === EXPLORE_LIBRARY_NAME ||
      library.Slug === EXPLORE_LIBRARY_SLUG
  ) || null
const groups = explore ? groupByCollection(explore.Entries) : []
const title = explore?.Name || '探索'
const description = explore?.Description || ''
---

<Layout title={title} description={description} path="/explore">
  <div slot="main">
    <h1>{title}</h1>
    <p class="lede">你好，下方的进度条是评分哦(≧∇≦)ﾉ</p>

    <CollageBoard
      groups={groups}
      emptyText="清单还空着，等我先看几部片子。"
    />

    <StickerBoard collection="探索" label="探索贴画" />
  </div>
</Layout>

<style>
  .lede {
    width: var(--text-width);
    color: var(--muted);
  }
</style>
