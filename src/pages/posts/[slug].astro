---
import * as interfaces from '../../lib/interfaces.ts'
import {
  getAllPosts,
  getPostBySlug,
  getBlock,
  getAllBlocksByBlockId,
  downloadFile,
} from '../../lib/notion/client.ts'
import {
  getPostLink,
  getDateStr,
  filePath,
  extractTargetBlocks,
  resolveNotionAssetUrl,
} from '../../lib/blog-helpers.ts'
import { notionLocalFileReady } from '../../lib/notion/media-file.ts'
import Layout from '../../layouts/Layout.astro'
import PostCover from '../../components/PostCover.astro'
import PostMeta from '../../components/PostMeta.astro'
import PostBody from '../../components/PostBody.astro'
import PostRelativeLink from '../../components/PostRelativeLink.astro'

export async function getStaticPaths() {
  const posts = await getAllPosts()
  return posts.map((post: interfaces.Post) => ({ params: { slug: post.Slug } }))
}

const { slug } = Astro.params
if (!slug) {
  throw new Error('Missing slug')
}

const post = await getPostBySlug(slug)
if (!post) {
  throw new Error(`Post not found. slug: ${slug}`)
}

const [blocks, allPosts] = await Promise.all([
  getAllBlocksByBlockId(post.PageId),
  getAllPosts(),
])

const fileAtacchedBlocks = extractTargetBlocks('image', blocks)
  .concat(extractTargetBlocks('file', blocks))
  .filter((block) => {
    if (!block) {
      return false
    }
    const imageOrFile = block.Image || block.File
    return imageOrFile && imageOrFile.File && imageOrFile.File.Url
  })

// 落地 Notion 托管附件；本地已有则跳过 refresh + 下载（dev 热路径）
await Promise.all(
  fileAtacchedBlocks.map(async (block) => {
    const cachedUrl = (block.Image || block.File)?.File?.Url
    if (cachedUrl) {
      try {
        if (notionLocalFileReady(new URL(cachedUrl))) {
          return
        }
      } catch {
        // URL 非法时继续走下方 refresh / 下载逻辑
      }
    }

    const expiryTime = (block.Image || block.File)?.File?.ExpiryTime
    const fresh =
      expiryTime && Date.parse(expiryTime) > Date.now()
        ? block
        : await getBlock(block.Id)

    const fileUrl = (fresh.Image || fresh.File)?.File?.Url
    if (!fileUrl) {
      return
    }

    try {
      await downloadFile(new URL(fileUrl))
    } catch {
      console.log('Invalid file URL: ', fileUrl)
    }
  })
)

const currentPostIndex = allPosts.findIndex((post) => post.Slug === slug)
const prevPost = allPosts[currentPostIndex + 1]
const nextPost = allPosts[currentPostIndex - 1]

let ogImage = ''
const coverSource = post.Cover?.Url ? post.Cover : post.FeaturedImage
const hasCover = Boolean(coverSource?.Url)
// 旁注里写给读者看的头图来源：外链保留原地址，Notion 托管文件用站内路径
const coverSourceHref = hasCover ? resolveNotionAssetUrl(coverSource) : ''
const coverSourceLink =
  coverSourceHref && !/^https?:\/\//i.test(coverSourceHref)
    ? new URL(coverSourceHref, Astro.site).toString()
    : coverSourceHref
if (hasCover && coverSource?.Url) {
  ogImage = new URL(filePath(new URL(coverSource.Url)), Astro.site).toString()
}
---

<Layout
  title={post.Title}
  description={post.Excerpt}
  path={getPostLink(post.Slug)}
  ogImage={ogImage}
  showCover={hasCover}
>
  {hasCover && <PostCover slot="cover" post={post} />}
  <div slot="main">
    <article class="post">
      <h1 class="post-title">
        {
          post.Icon && interfaces.isEmojiIcon(post.Icon) ? (
            <span class="title-icon">{post.Icon.Emoji}</span>
          ) : post.Icon && interfaces.isExternalIcon(post.Icon) ? (
            <img class="title-icon" src={post.Icon.Url} alt="" width="24" height="24" data-image-component="true" />
          ) : null
        }
        {post.Title}
      </h1>
      {
        (post.Date || coverSourceLink) && (
          <p class="subtitle">
            {post.Date && (
              <time class="numeral" datetime={post.Date}>
                {getDateStr(post.Date)}
              </time>
            )}
            {coverSourceLink && (
              <>
                <label class="margin-toggle" for={`cover-source-${slug}`}>
                  &#8853;
                </label>
                <input
                  type="checkbox"
                  id={`cover-source-${slug}`}
                  class="margin-toggle"
                />
                <span class="marginnote cover-source-note">
                  头图来源：
                  <a
                    href={coverSourceLink}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {coverSourceLink}
                  </a>
                </span>
              </>
            )}
          </p>
        )
      }

      <PostBody blocks={blocks} />

      <!-- 收束占位：稍后可换成更古典的花饰 -->
      <p class="article-close" aria-hidden="true">❧</p>

      <footer class="post-footer">
        <PostMeta post={post} enableLink={true} />
        <PostRelativeLink prevPost={prevPost} nextPost={nextPost} />
      </footer>
    </article>
  </div>
</Layout>

<style>
  .post-title .title-icon {
    margin-right: 0.3em;
  }
  .post-title img.title-icon {
    width: 1.1em;
    height: 1.1em;
    vertical-align: -0.15em;
  }
  .cover-source-note {
    font-style: normal;
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  .cover-source-note a {
    font-family: var(--font-mono);
    font-size: 0.85em;
  }
  .article-close {
    width: 55%;
    margin: 2.8rem 0 0;
    padding: 0;
    text-align: center;
    color: var(--muted);
    font-size: 1rem;
    letter-spacing: 0.2em;
    line-height: 1;
  }
  .post-footer {
    width: 55%;
    margin-top: 1.6rem;
    border-top: 1px solid var(--line);
    padding-top: 1.2rem;
  }
  @media (max-width: 760px) {
    .article-close,
    .post-footer {
      width: 100%;
    }
  }
</style>
