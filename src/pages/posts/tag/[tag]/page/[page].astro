---
import type { SelectProperty } from '../../../../../lib/interfaces.ts'
import {
  getAllTags,
  getNumberOfPagesByTag,
} from '../../../../../lib/notion/client.ts'
import { getNavLink } from '../../../../../lib/blog-helpers.ts'

// 标签分页已合并为完整列表，这里仅作旧链接回退
export async function getStaticPaths() {
  const allTags = await getAllTags()
  const params: { params: { tag: string; page: string } }[] = []
  await Promise.all(
    allTags.map((tag: SelectProperty) =>
      getNumberOfPagesByTag(tag.name).then((numberOfPages: number) => {
        for (let i = 2; i <= numberOfPages; i++) {
          params.push({ params: { tag: tag.name, page: i.toString() } })
        }
      })
    )
  )
  return params
}

const { tag } = Astro.params
return Astro.redirect(getNavLink(`/posts/tag/${tag}`))
---
