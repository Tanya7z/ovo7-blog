---
import { getAllPosts } from '../../../lib/notion/client.ts'
import { getNavLink } from '../../../lib/blog-helpers.ts'
import { NUMBER_OF_POSTS_PER_PAGE } from '../../../server-constants.ts'

// 分页页面已合并为年月归档，这里仅作旧链接回退
export async function getStaticPaths() {
  const posts = await getAllPosts()
  const numberOfPages = Math.max(
    1,
    Math.ceil(posts.length / NUMBER_OF_POSTS_PER_PAGE)
  )
  const params: { params: { page: string } }[] = []
  for (let i = 2; i <= numberOfPages; i++) {
    params.push({ params: { page: i.toString() } })
  }
  return params
}

return Astro.redirect(getNavLink('/posts'))
---
