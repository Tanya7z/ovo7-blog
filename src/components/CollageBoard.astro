---
import Tape from './Tape.astro'
import { resolveNotionAssetUrl } from '../lib/blog-helpers.ts'
import type { LibraryGroup } from '../lib/interfaces.ts'
import '../styles/sticker.css'

export interface Props {
  groups: LibraryGroup[]
  emptyText?: string
}

const {
  groups,
  emptyText = '清单还空着。',
} = Astro.props
---

{
  groups.length === 0 && <p class="empty">{emptyText}</p>
}

{
  groups.length > 1 && (
    <nav class="tabs" aria-label="按集合跳转">
      {groups.map((group) => (
        <a href={`#collection-${encodeURIComponent(group.collection)}`}>
          {group.collection}
          <span class="count">{group.entries.length}</span>
        </a>
      ))}
    </nav>
  )
}

{
  groups.map((group) => (
    <section class="group" id={`collection-${group.collection}`}>
      <h2>{group.collection}</h2>
      <ul class="collage">
            {group.entries.map((entry, index) => {
              const image = resolveNotionAssetUrl(entry.Image)
              const landscape = index % 2 === 1
              return (
                <li class="cell">
                  <figure class="polaroid">
                    <Tape />
                    {image ? (
                      <img
                        src={image}
                        alt={entry.Name}
                        width={landscape ? 4 : 3}
                        height={landscape ? 3 : 4}
                        loading="lazy"
                        decoding="async"
                        data-image-component="true"
                      />
                    ) : (
                      <div class="blank" aria-hidden="true" />
                    )}
                <figcaption>
                  <span class="name">{entry.Name}</span>
                  {entry.Author && <span class="meta">{entry.Author}</span>}
                  {entry.Place && <span class="meta">{entry.Place}</span>}
                  {entry.Status && (
                    <span class="meta status">{entry.Status}</span>
                  )}
                  {entry.Score !== null && (
                    <span
                      class="score"
                      role="img"
                      aria-label={`评分 ${entry.Score} / 10`}
                    >
                      <span
                        class="score-fill"
                        style={`width: ${entry.Score * 10}%`}
                      />
                    </span>
                  )}
                </figcaption>
              </figure>
            </li>
          )
        })}
      </ul>
    </section>
  ))
}

<style>
  .empty {
    width: var(--text-width);
    color: var(--muted);
  }

  /* 类目索引：像贴在本子边上的一排纸标签 */
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 0.7rem;
    margin-top: 2rem;
  }

  .tabs a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    border: 1px solid var(--line);
    border-bottom-width: 2px;
    padding: 0.25rem 0.8rem;
    /* 用主题令牌，勿用贴纸的 --photo-paper（深色下仍是浅底） */
    background: var(--soft);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.15rem;
    text-decoration: none;
    font-synthesis: none;
  }

  .tabs a:nth-child(2n) {
    transform: rotate(-0.8deg);
  }

  .tabs a:nth-child(2n + 1) {
    transform: rotate(0.6deg);
  }

  .tabs a:hover {
    background: var(--paper);
  }

  .tabs .count {
    color: var(--muted);
    font-family: var(--font-numeral);
    font-size: 0.9rem;
  }

  .group {
    margin-top: 3.4rem;
    /* 锚点跳转时给站点 header 留出余量 */
    scroll-margin-top: 1.5rem;
  }

  .group h2 {
    margin-bottom: 1.8rem;
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.6rem;
  }

  /* 复合网格（6/5 叠加得到的 10 条轨道），参考 CSS-IRL 的 scrapbook 布局。
   * 卡片跨不同轨道组，宽度天然不等，避免整齐排排坐的呆板感。
   */
  .collage {
    --overlap: 6rem;
    --verticalPadding: 2rem;
    display: grid;
    grid-template-columns: 5fr 1fr 4fr 2fr 3fr 3fr 2fr 4fr 1fr 5fr;
    row-gap: var(--verticalPadding);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cell {
    padding: 0 0.9rem;
  }

  .cell:nth-child(3n + 1) {
    grid-column: 1 / 5;
    --rotate: -1.5deg;
  }

  .cell:nth-child(3n + 2) {
    grid-column: 5 / 8;
    margin-top: var(--overlap);
    --rotate: 1.2deg;
  }

  .cell:nth-child(3n + 3) {
    grid-column: 8 / 11;
    margin-top: calc(var(--overlap) * -0.5);
    --rotate: -0.8deg;
  }

  /* 强制统一画幅：海报竖、剧照横交替，缺封面时留一块空白相纸 */
  .cell :global(img),
  .blank {
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  .cell:nth-child(2n) :global(img),
  .cell:nth-child(2n) .blank {
    aspect-ratio: 4 / 3;
  }

  .blank {
    width: 100%;
    background: repeating-linear-gradient(
      45deg,
      #f4f0e4 0 6px,
      #efeade 6px 12px
    );
  }

  /* 相纸底边比贴画更高，要塞下名称、状态与评分 */
  .cell :global(.polaroid) {
    padding-bottom: 5rem;
  }

  figcaption {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
  }

  .name {
    color: var(--photo-ink);
    font-size: 1.05rem;
    line-height: 1.3;
    text-align: center;
  }

  .meta {
    color: var(--photo-muted);
    font-size: 0.92rem;
    line-height: 1.3;
  }

  .score {
    display: block;
    width: 60%;
    height: 3px;
    margin-top: 0.25rem;
    background: var(--photo-line);
  }

  .score-fill {
    display: block;
    height: 100%;
    background: var(--photo-muted);
  }

  /* 窄屏：取消复合网格与重叠，退回等宽两列 */
  @media (max-width: 760px) {
    .empty {
      width: 100%;
    }

    .collage {
      grid-template-columns: 1fr;
      row-gap: 2.4rem;
    }

    .cell[class] {
      grid-column: auto;
      margin-top: 0;
    }
  }
</style>
