---
import type { Post } from '../lib/interfaces.ts'
import { getNavLink, getPostLink } from '../lib/blog-helpers.ts'

export interface Props {
  prevPost?: Post | null
  nextPost?: Post | null
}

const { prevPost, nextPost } = Astro.props
---

<nav class="post-relative-link" aria-label="上下篇导航">
  {
    nextPost && (
      <a class="rel" href={getPostLink(nextPost.Slug)}>
        <span class="rel-label">下一篇</span>
        <span class="rel-title">{nextPost.Title}</span>
      </a>
    )
  }
  {
    prevPost && (
      <a class="rel" href={getPostLink(prevPost.Slug)}>
        <span class="rel-label">上一篇</span>
        <span class="rel-title">{prevPost.Title}</span>
      </a>
    )
  }
  <a class="rel back" href={getNavLink('/posts')}>返回文章列表</a>
</nav>

<style>
  .post-relative-link {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-top: 1.4rem;
  }
  .rel {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 1.1rem;
    line-height: 1.5;
  }
  .rel-label {
    flex: 0 0 auto;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .rel.back {
    margin-top: 0.6rem;
  }
</style>
