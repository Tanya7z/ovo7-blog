---
import type { Post, SelectProperty } from '../lib/interfaces.ts'
import { getTagLink } from '../lib/blog-helpers.ts'

export interface Props {
  post: Post
  enableLink?: boolean
}

const { post, enableLink = true } = Astro.props
---

<div class="post-tags">
  {
    post.Tags &&
      post.Tags.length > 0 &&
      post.Tags.map((tag: SelectProperty) => {
        if (enableLink) {
          return <a href={getTagLink(tag.name)}>{tag.name}</a>
        }
        return <span>{tag.name}</span>
      })
  }
</div>

<style>
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin-bottom: 1.2rem;
    font-size: 1.1rem;
  }
  .post-tags a,
  .post-tags span {
    color: var(--muted);
  }
</style>
