---
import { Icon } from 'astro-icon/components'
---

<div
  class="search-modal-container"
  role="dialog"
  aria-modal="true"
  aria-label="搜索文章"
  aria-hidden="true"
>
  <div class="overlay" data-close-search></div>

  <div class="search-modal">
    <div class="search-modal-header">
      <span>搜索文章</span>
      <button
        class="search-close"
        type="button"
        data-close-search
        aria-label="关闭搜索"
        title="关闭搜索"
      ><Icon name="ph:x-light" /></button>
    </div>
    <div class="search-prompt">
      <input
        type="search"
        placeholder="输入文章标题…"
        aria-label="搜索关键词"
        autocomplete="off"
      />
    </div>
    <div class="search-result" aria-live="polite">
      <ul>
      </ul>
      <p class="search-empty" hidden>没有找到匹配文章</p>
    </div>
  </div>
</div>

<style>
  div.search-modal-container {
    display: none;
  }

  div.overlay {
    z-index: 99;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(24, 30, 26, 0.48);
    backdrop-filter: blur(4px);
  }

  div.search-modal {
    z-index: 100;
    position: fixed;
    top: 12vh;
    left: 50%;
    width: min(640px, calc(100% - 32px));
    transform: translateX(-50%);
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 6px;
    background-color: var(--bg);
    box-shadow: 0 24px 70px rgba(22, 30, 25, 0.2);
  }
  .search-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
    padding: 12px 12px 10px 16px;
    color: var(--fg);
    font-size: 14px;
    font-weight: 700;
  }
  .search-close {
    display: grid;
    width: 32px;
    height: 32px;
    place-items: center;
    border: 0;
    border-radius: var(--radius);
    padding: 0;
    background: transparent;
    color: var(--muted);
  }
  .search-close:hover {
    cursor: pointer;
    background: var(--soft);
    color: var(--ink);
  }
  .search-close svg {
    width: 17px;
    height: 17px;
  }
  @media (max-width: 640px) {
    div.search-modal {
      top: 72px;
    }
  }

  div.search-prompt {
    margin: 0;
    padding: 12px;
  }
  div.search-prompt input {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 10px 12px;
    background-color: var(--input-bg);
    color: var(--fg);
    font-size: 16px;
    line-height: 1.6rem;
  }

  div.search-result {
    border-top: 1px solid var(--hr-border);
  }
  div.search-result ul {
    list-style: none;
    margin: 0.3rem;
    padding: 0;
  }
  .search-empty {
    margin: 0;
    padding: 14px 16px 18px;
    color: var(--muted);
    font-size: 14px;
  }
  div.search-result ul > :global(li) {
  }
  div.search-result ul > :global(li > a) {
    display: block;
    padding: 0.4rem 0.6rem;
    border-radius: var(--radius);
  }
  div.search-result ul > :global(li.selected > a) {
    background-color: var(--soft);
  }

  div.search-result ul > :global(li > a:hover) {
    background-color: var(--soft);
  }

  div.search-result :global(div.search-result-title) {
    padding: 0.1rem 0;
    color: var(--fg);
    font-size: 1.1rem;
    line-height: 1.2rem;
    font-weight: bold;
  }
  div.search-result :global(div.search-result-description) {
    margin: 0 0 0.1rem;
    color: var(--fg);
    font-size: 0.9rem;
    line-height: 1.2rem;
  }
</style>

<script>
  interface FeedItem {
    title: string
    link: string
    description: string
    pubDate: string
  }

  let feedItems: FeedItem[] = []
  let fetched = false
  let isOpen = false
  let container: HTMLElement | null = null
  let input: HTMLInputElement | null = null
  let resultList: HTMLElement | null = null
  let emptyState: HTMLElement | null = null
  let didBindGlobals = false

  function refreshElements() {
    const containerEl = document.querySelector('.search-modal-container')
    const inputEl = document.querySelector('.search-prompt input')
    const resultListEl = document.querySelector('.search-result ul')
    const emptyStateEl = document.querySelector('.search-empty')

    container = containerEl instanceof HTMLElement ? containerEl : null
    input = inputEl instanceof HTMLInputElement ? inputEl : null
    resultList = resultListEl instanceof HTMLElement ? resultListEl : null
    emptyState = emptyStateEl instanceof HTMLElement ? emptyStateEl : null

    if (input && !input.dataset.searchBound) {
      input.dataset.searchBound = '1'
      input.addEventListener('input', searchAndRender)
    }

    document.querySelectorAll('.open-search-modal').forEach((element) => {
      if (!(element instanceof HTMLElement)) return
      if (!element.hasAttribute('aria-expanded')) {
        element.setAttribute('aria-expanded', 'false')
      }
    })
  }

  async function openModal() {
    refreshElements()
    if (!container || !input) return

    isOpen = true
    container.style.display = 'block'
    container.setAttribute('aria-hidden', 'false')
    document
      .querySelectorAll('.open-search-modal')
      .forEach((el) => el.setAttribute('aria-expanded', 'true'))
    input.focus()

    if (!fetched) {
      try {
        await fetchRSS()
      } catch (error) {
        console.error(error)
        fetched = true
      }
    }
    if (isOpen) searchAndRender()
  }

  function closeModal() {
    refreshElements()
    if (!container) return

    isOpen = false
    container.style.display = 'none'
    container.setAttribute('aria-hidden', 'true')
    document
      .querySelectorAll('.open-search-modal')
      .forEach((el) => el.setAttribute('aria-expanded', 'false'))

    const trigger = document.querySelector('.open-search-modal')
    if (trigger instanceof HTMLElement) trigger.focus()
  }

  function handleKeydown(event: KeyboardEvent) {
    if (!isOpen) return

    if (event.key === 'Enter') {
      select()
    } else if (event.key === 'Escape') {
      closeModal()
    } else if (event.key === 'ArrowUp') {
      selectUp(event)
    } else if (event.key === 'ArrowDown') {
      selectDown(event)
    }
  }

  function select() {
    if (!resultList) return
    const anchor = resultList.querySelector('li.selected a')
    if (anchor instanceof HTMLElement) anchor.click()
  }

  function selectFirst() {
    if (!resultList) return
    const first = resultList.firstElementChild
    if (first) first.classList.add('selected')
  }

  function selectUp(event: KeyboardEvent) {
    event.preventDefault()
    if (!resultList?.children.length) return

    const selected = resultList.querySelector('.selected')
    if (selected) {
      selected.classList.remove('selected')
      ;(
        selected.previousElementSibling || resultList.lastElementChild
      )?.classList.add('selected')
    } else {
      resultList.lastElementChild?.classList.add('selected')
    }
  }

  function selectDown(event: KeyboardEvent) {
    event.preventDefault()
    if (!resultList?.children.length) return

    const selected = resultList.querySelector('.selected')
    if (selected) {
      selected.classList.remove('selected')
      ;(
        selected.nextElementSibling || resultList.firstElementChild
      )?.classList.add('selected')
    } else {
      resultList.firstElementChild?.classList.add('selected')
    }
  }

  function handleMouseover(event: Event) {
    if (!resultList) return
    const target = event.target
    if (!(target instanceof Element)) return
    const item = target.closest('li')
    if (!item) return
    Array.from(resultList.children).forEach((element) => {
      element.classList.remove('selected')
    })
    item.classList.add('selected')
  }

  function searchAndRender() {
    if (!input || !resultList || !emptyState) return
    const text = input.value.trim()
    renderResults(text ? search(text) : feedItems)
    selectFirst()
  }

  function search(query: string) {
    const normalizedQuery = query.toLocaleLowerCase()
    return feedItems.filter((item) => {
      return (
        item.title.toLocaleLowerCase().includes(normalizedQuery) ||
        item.description?.toLocaleLowerCase().includes(normalizedQuery)
      )
    })
  }

  function renderResults(results: FeedItem[]) {
    const list = resultList
    const empty = emptyState
    if (!list || !empty) return
    list.innerHTML = ''
    empty.hidden = results.length !== 0

    results.forEach((item) => {
      const li = document.createElement('li')
      const anchor = document.createElement('a')
      const title = document.createElement('div')
      const description = document.createElement('div')

      title.classList.add('search-result-title')
      title.textContent = item.title
      description.classList.add('search-result-description')
      description.textContent = item.description || ''
      anchor.href = item.link

      li.addEventListener('mouseover', handleMouseover)
      anchor.append(title, description)
      li.appendChild(anchor)
      list.appendChild(li)
    })
  }

  async function fetchRSS() {
    const url = new URL(location.href)
    const port = url.port ? `:${url.port}` : ''
    const res = await fetch(`${url.protocol}//${url.hostname}${port}/feed`)
    if (!res.ok) throw new Error('Failed to fetch RSS feed')

    const parser = new DOMParser()
    const xml = parser.parseFromString(await res.text(), 'text/xml')
    feedItems = Array.from(xml.getElementsByTagName('item')).map((item) => ({
      title: item.getElementsByTagName('title')[0]?.textContent || '',
      link: item.getElementsByTagName('link')[0]?.textContent || '#',
      description:
        item.getElementsByTagName('description')[0]?.textContent || '',
      pubDate: item.getElementsByTagName('pubDate')[0]?.textContent || '',
    }))
    fetched = true
  }

  function bindGlobals() {
    if (didBindGlobals) return
    didBindGlobals = true

    document.addEventListener('click', (event) => {
      const target = event.target
      if (!(target instanceof Element)) return
      if (target.closest('.open-search-modal')) {
        event.preventDefault()
        openModal()
        return
      }
      if (target.closest('[data-close-search]')) {
        closeModal()
      }
    })
    document.addEventListener('keydown', handleKeydown)
  }

  // 首次加载与 ClientRouter 换页后都会触发
  document.addEventListener('astro:page-load', () => {
    bindGlobals()
    refreshElements()
    if (isOpen) closeModal()
  })
</script>
