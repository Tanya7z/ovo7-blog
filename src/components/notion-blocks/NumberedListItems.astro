---
import * as interfaces from '../../lib/interfaces.ts'
import { snakeToKebab } from '../../lib/style-helpers.ts'
import RichText from './RichText.astro'
import NotionBlocks from '../NotionBlocks.astro'
import '../../styles/notion-color.css'

export interface Props {
  block: interfaces.List
  level: number
  headings: interfaces.Block[]
}

const { block, level, headings } = Astro.props

const listTypes = ['i', '1', 'a'] as const
const listType = listTypes[level % 3] ?? '1'
---

<ol type={listType}>
  {
    block.ListItems.filter(
      (b: interfaces.Block) => b.Type === 'numbered_list_item'
    ).map((b: interfaces.Block) => {
      const numbered = interfaces.must(b.NumberedListItem, 'NumberedListItem')
      return (
      <li class={snakeToKebab(numbered.Color)}>
        {numbered.RichTexts.map((richText: interfaces.RichText) => (
          <RichText richText={richText} />
        ))}
        {b.HasChildren && numbered.Children && (
          <NotionBlocks
            blocks={numbered.Children}
            level={level + 1}
            headings={headings}
          />
        )}
      </li>
      )
    })
  }
</ol>
