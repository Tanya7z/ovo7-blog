---
import katex from 'katex'
import * as interfaces from '../../lib/interfaces.ts'

export interface Props {
  block: interfaces.Block
}

const { block } = Astro.props
const equation = interfaces.must(block.Equation, 'Equation')
---

<div
  class="equation"
  set:html={katex.renderToString(equation.Expression, {
    throwOnError: false,
  })}
/>

<style>
  .equation {
    text-align: center;
  }
</style>
