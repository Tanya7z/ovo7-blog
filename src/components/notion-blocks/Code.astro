---
import Prism from 'prismjs'
import 'prismjs/components/prism-css'
import 'prismjs/components/prism-diff'
import 'prismjs/components/prism-docker'
import 'prismjs/components/prism-elixir'
import 'prismjs/components/prism-go'
import 'prismjs/components/prism-hcl'
import 'prismjs/components/prism-java'
import 'prismjs/components/prism-json'
import 'prismjs/components/prism-python'
import 'prismjs/components/prism-ruby'
import 'prismjs/components/prism-sql'
import 'prismjs/components/prism-typescript'
import 'prismjs/components/prism-yaml'
import * as interfaces from '../../lib/interfaces'
import Caption from './Caption.astro'

export interface Props {
  block: interfaces.Block
}

const { block } = Astro.props
const codeBlock = interfaces.must(block.Code, 'Code')

const code = codeBlock.RichTexts.map(
  (richText: interfaces.RichText) => richText.Text?.Content ?? ''
).join('')
const language = codeBlock.Language.toLowerCase()
const grammer =
  Prism.languages[language.toLowerCase()] || Prism.languages.javascript
---

<div class="code">
  <div>
    {
      /* prettier-ignore */
      language === 'mermaid' ? (
        <pre class="mermaid">{code}</pre>
      ) : (
        <>
          <div>
            <button class="copy" data-code={code} data-done-text="Copied!">
              Copy
            </button>
          </div>
          <pre><code set:html={Prism.highlight(code, grammer, language)} /></pre>
        </>
      )
    }
  </div>
  <Caption richTexts={codeBlock.Caption} />
</div>

<script>
  import mermaid from 'mermaid'

  let mermaidReady = false

  function ensureMermaid() {
    if (mermaidReady) return
    mermaid.initialize({
      startOnLoad: false,
      theme: window.matchMedia('(prefers-color-scheme: dark)').matches
        ? 'dark'
        : 'neutral',
    })
    mermaidReady = true
  }

  document.addEventListener('astro:page-load', async () => {
    const nodes = document.querySelectorAll('.mermaid')
    if (nodes.length === 0) return
    ensureMermaid()
    await mermaid.run({
      nodes: Array.from(nodes).filter(
        (node): node is HTMLElement => node instanceof HTMLElement
      ),
    })
  })
</script>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('button.copy').forEach((button) => {
      if (!(button instanceof HTMLButtonElement)) return
      if (button.dataset.copyBound === '1') return
      button.dataset.copyBound = '1'

      button.addEventListener('click', (ev) => {
        const target = ev.currentTarget
        if (!(target instanceof HTMLButtonElement)) return
        const copied = target.getAttribute('data-code') ?? ''
        const doneText = target.getAttribute('data-done-text') ?? 'Copied!'

        navigator.clipboard.writeText(copied).then(() => {
          const originalText = target.innerText
          target.innerText = doneText
          setTimeout(() => {
            target.innerText = originalText
          }, 3000)
        })
      })
    })
  })
</script>

<style>
  .code {
    display: block;
    width: 100%;
    margin: 1.2rem 0;
  }
  .code > div {
    background: transparent;
    border-radius: 0;
  }
  .code > div div {
    display: flex;
    justify-content: flex-end;
  }
  .code button.copy {
    display: block;
    width: auto;
    padding: 0 0.2rem;
    border: 0;
    border-radius: 0;
    background-color: transparent;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    line-height: 1.4rem;
    cursor: pointer;
    opacity: 0.7;
  }
  .code button.copy:hover,
  .code button.copy:focus-visible {
    opacity: 1;
    text-decoration: underline;
  }
  .code pre {
    display: block;
    overflow: auto;
    padding: 0.4rem 0 0.8rem;
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.42;
    white-space: pre;
    width: 100px;
    min-width: 100%;
    overflow-x: auto;
    border: 0;
    background: transparent;
    &::-webkit-scrollbar {
      height: 8px;
    }
    &::-webkit-scrollbar-thumb {
      background: var(--line);
    }
    &::-webkit-scrollbar-track {
      background: transparent;
    }
  }
  .code pre.mermaid {
    padding: 1.2rem 0;
  }
  .code pre code {
    color: var(--fg);
    padding: 0;
    background: transparent !important;
    border-radius: 0;
  }
</style>
