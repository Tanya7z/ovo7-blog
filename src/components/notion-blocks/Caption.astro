---
import type { RichText as RichTextType } from '../../lib/interfaces.ts'
import type { FigureLayout } from '../../lib/tufte.ts'
import RichText from './RichText.astro'

export interface Props {
  richTexts: RichTextType[]
  layout?: FigureLayout
}

const { richTexts, layout = 'column' } = Astro.props
const hasText = richTexts.some(
  (rt) => (rt.Text?.Content ?? rt.PlainText ?? '').length > 0
)
---

{
  hasText && (
    <div class:list={['caption', `caption-${layout}`]}>
      {richTexts.map((richText) => (
        <RichText richText={richText} />
      ))}
    </div>
  )
}

<style>
  .caption {
    font-size: 1.1rem;
    line-height: 1.4;
    color: var(--muted);
    white-space: pre-wrap;
    word-break: break-word;
  }

  /* 正文栏图：图注浮入右侧留白 */
  .caption-column {
    float: right;
    clear: right;
    margin-top: 0.3rem;
    margin-right: -60%;
    width: 50%;
  }

  /* 旁注图：图注跟在图下，不再二次浮动 */
  .caption-margin {
    float: none;
    width: 100%;
    margin: 0;
  }

  .caption-fullwidth {
    float: right;
    clear: right;
    margin-top: 0.4rem;
    margin-right: 0;
    width: 50%;
  }

  @media (max-width: 760px) {
    .caption-column,
    .caption-fullwidth {
      float: none;
      width: 100%;
      margin-right: 0;
      font-size: 1rem;
    }
  }
</style>
