---
import * as interfaces from '../../lib/interfaces.ts'
import { snakeToKebab } from '../../lib/style-helpers.ts'
import RichText from './RichText.astro'
import NotionBlocks from '../NotionBlocks.astro'
import '../../styles/notion-color.css'

export interface Props {
  block: interfaces.List
  headings: interfaces.Block[]
}

const { block, headings } = Astro.props
---

<div class="to-do">
  {
    block.ListItems.filter((b: interfaces.Block) => b.Type === 'to_do').map(
      (b: interfaces.Block) => {
        const todo = interfaces.must(b.ToDo, 'ToDo')
        return (
        <div class={snakeToKebab(todo.Color)}>
          <input type="checkbox" checked={todo.Checked} disabled />
          {todo.RichTexts.map((richText: interfaces.RichText) => {
            if (todo.Checked) {
              return (
                <s>
                  <RichText richText={richText} />
                </s>
              )
            }
            return <RichText richText={richText} />
          })}
          {b.HasChildren && todo.Children && (
            <NotionBlocks blocks={todo.Children} headings={headings} />
          )}
        </div>
        )
      }
    )
  }
</div>

<style>
  .to-do {
    color: var(--ink);
    font-weight: 400;
    line-height: 2rem;
    padding-inline-start: 1rem;
  }
  .to-do > div {
  }
  .to-do > div > input {
  }
  .to-do > div > s {
    color: var(--accents-3);
  }
</style>
