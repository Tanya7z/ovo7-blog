---
import * as interfaces from '../../lib/interfaces.ts'
import { snakeToKebab } from '../../lib/style-helpers.ts'
import { splitQuoteAttribution } from '../../lib/tufte.ts'
import RichText from './RichText.astro'
import NotionBlocks from '../NotionBlocks.astro'
import '../../styles/notion-color.css'

export interface Props {
  block: interfaces.Block
  headings: interfaces.Block[]
  /** 文首引用：按 Tufte epigraph 排，不论是否带署名 */
  asEpigraph?: boolean
}

const { block, headings, asEpigraph = false } = Astro.props
const quote = interfaces.must(block.Quote, 'Quote')
const { body, attribution } = splitQuoteAttribution(quote.RichTexts)
const isEpigraph = asEpigraph || attribution !== null
const quoteBody = attribution !== null ? body : quote.RichTexts
---

{
  isEpigraph ? (
    <div class="epigraph">
      <blockquote class={snakeToKebab(quote.Color)}>
        {quoteBody.map((richText: interfaces.RichText) => (
          <RichText richText={richText} />
        ))}
        {attribution && <footer>{attribution}</footer>}
        {quote.Children && (
          <NotionBlocks blocks={quote.Children} headings={headings} />
        )}
      </blockquote>
    </div>
  ) : (
    <blockquote class={snakeToKebab(quote.Color)}>
      {quote.RichTexts.map((richText: interfaces.RichText) => (
        <RichText richText={richText} />
      ))}
      {quote.Children && (
        <NotionBlocks blocks={quote.Children} headings={headings} />
      )}
    </blockquote>
  )
}

<style>
  blockquote {
    margin: 1.5rem 0;
  }
</style>
