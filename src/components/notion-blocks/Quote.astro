---
import * as interfaces from '../../lib/interfaces.ts'
import {
  countSidenoteMarkers,
  splitQuoteAttribution,
  type ParagraphNotePlan,
} from '../../lib/tufte.ts'
import RichText from './RichText.astro'
import NotionBlocks from '../NotionBlocks.astro'
import Callout from './Callout.astro'

export interface Props {
  block: interfaces.Block
  headings: interfaces.Block[]
  /** 文首引用：按 Tufte epigraph 排，不论是否带署名 */
  asEpigraph?: boolean
  /** [*] 旁注挂载计划 */
  notePlan?: ParagraphNotePlan
}

const { block, headings, asEpigraph = false, notePlan } = Astro.props
const quote = interfaces.must(block.Quote, 'Quote')
const { body, attribution } = splitQuoteAttribution(quote.RichTexts)
const isEpigraph = asEpigraph || attribution !== null

const shouldUseNotePlan =
  !!notePlan &&
  (notePlan.trailingNotes.length > 0 ||
    notePlan.segments.some((s) => s.type === 'note') ||
    countSidenoteMarkers(quote.RichTexts) > 0)

const fallbackTexts = attribution !== null ? body : quote.RichTexts
const segments = shouldUseNotePlan
  ? notePlan!.segments
  : [{ type: 'text' as const, richTexts: fallbackTexts }]
const trailingNotes = shouldUseNotePlan ? notePlan!.trailingNotes : []
const hasNotes =
  trailingNotes.length > 0 || segments.some((s) => s.type === 'note')

const quoteClass = hasNotes ? 'tufte-quote' : undefined
---

{
  isEpigraph ? (
    <div class="epigraph">
      <blockquote class={quoteClass}>
        {segments.map((segment) =>
          segment.type === 'text' ? (
            segment.richTexts.map((richText: interfaces.RichText) => (
              <RichText richText={richText} />
            ))
          ) : (
            <Callout block={segment.block} headings={headings} />
          )
        )}
        {trailingNotes.map((note) => (
          <Callout block={note} headings={headings} />
        ))}
        {attribution && !shouldUseNotePlan && <footer>{attribution}</footer>}
        {quote.Children && (
          <NotionBlocks blocks={quote.Children} headings={headings} />
        )}
      </blockquote>
    </div>
  ) : (
    <blockquote class={quoteClass}>
      {segments.map((segment) =>
        segment.type === 'text' ? (
          segment.richTexts.map((richText: interfaces.RichText) => (
            <RichText richText={richText} />
          ))
        ) : (
          <Callout block={segment.block} headings={headings} />
        )
      )}
      {trailingNotes.map((note) => (
        <Callout block={note} headings={headings} />
      ))}
      {quote.Children && (
        <NotionBlocks blocks={quote.Children} headings={headings} />
      )}
    </blockquote>
  )
}
