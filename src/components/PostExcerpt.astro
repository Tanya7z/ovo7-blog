---
import { Post } from '../lib/interfaces.ts'

export interface Props {
  post: Post
}

const { post } = Astro.props
---

{post.Excerpt && (
  <div class="post-excerpt">
    <p>{post.Excerpt}</p>
  </div>
)}

<style>
  .post-excerpt {
    padding: 8px 0 0;
    font-size: 15px;
  }

  .post-excerpt p {
    margin: 0;
    color: var(--muted);
  }
</style>
