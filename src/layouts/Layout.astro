---
import { ClientRouter } from 'astro:transitions'
import { Image } from 'astro:assets'
import {
  ENABLE_LIGHTBOX,
  PUBLIC_GA_TRACKING_ID,
  SITE_LANGUAGE,
} from '../server-constants.ts'
import { getDatabase } from '../lib/notion/client.ts'
import { getNavLink, getStaticFilePath } from '../lib/blog-helpers.ts'
import '../styles/tufte.css'
import '../styles/syntax-coloring.css'
import GoogleAnalytics from '../components/GoogleAnalytics.astro'
import SearchModal from '../components/SearchModal.astro'
import NavTransition from '../components/NavTransition.astro'
import logo from '../assets/logo.png'

export interface Props {
  title?: string
  description?: string
  path?: string
  ogImage?: string
  bare?: boolean
  /** 有真实封面图时才渲染顶栏占位；勿依赖 slots.has（条件 slot 会误报） */
  showCover?: boolean
}

const {
  title = '',
  description = '',
  path = '/',
  ogImage = '',
  bare = false,
  showCover = false,
} = Astro.props
const hasCover = showCover
const database = await getDatabase()
const siteTitle = title ? `${title} · ${database.Title}` : database.Title
const siteDescription = description || database.Description
const siteURL = new URL(getNavLink(path), Astro.site).toString()
const siteOGImage = new URL(
  getStaticFilePath('/logo.png'),
  Astro.site
).toString()
---

<!doctype html>
<html lang={SITE_LANGUAGE} prefix="og: https://ogp.me/ns#">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="max-image-preview:large" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#fffff8"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#151515"
    />
    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription} />
    <link rel="canonical" href={siteURL} />
    <link rel="icon" type="image/png" href={getStaticFilePath('/favicon.png')} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={database.Title}
      href={getNavLink('/feed')}
    />
    <meta property="og:type" content={title ? 'article' : 'website'} />
    <meta property="og:url" content={siteURL} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:site_name" content={database.Title} />
    <meta property="og:image" content={ogImage || siteOGImage} />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage || siteOGImage} />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@chinese-fonts/zqfs@3.0.0/dist/ZhuqueFangsong-Regular/result.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.4/dist/katex.min.css"
      integrity="sha384-vKruj+a13U8yHIkAyGgK1J3ArTLzrFGBbBc0tDp4ad/EyewESeXE/Iv67Aj8gKZ0"
      crossorigin="anonymous"
    />
    <ClientRouter />
  </head>
  <body>
    <GoogleAnalytics trackingId={PUBLIC_GA_TRACKING_ID} />
    <a class="skip-link" href="#main-content">跳到正文</a>

    {
      !bare && (
        <header class="site-header">
          <div class="header-inner">
            <div class="header-bar">
              <a class="brand" href={getNavLink('/')}>
                <Image
                  class="brand-logo"
                  src={logo}
                  alt=""
                  width={36}
                  height={36}
                  densities={[1, 2]}
                />
                <span class="brand-title">{database.Title}</span>
              </a>
              <nav class="site-nav" aria-label="主导航">
                <a href={getNavLink('/')}>首页</a>
                <a href={getNavLink('/posts')}>文章</a>
                <a href={getNavLink('/explore')}>探索</a>
                <a class="search-button open-search-modal">检索</a>
              </nav>
            </div>
          </div>
        </header>
      )
    }

    {
      bare ? (
        <main id="main-content" class="bare-main" transition:animate="fade">
          <slot name="main" />
        </main>
      ) : (
        <>
          {hasCover && (
            <div class="page-cover" transition:animate="fade">
              <slot name="cover" />
            </div>
          )}
          <main
            id="main-content"
            class:list={['page-shell', 'tufte-body', { 'has-cover': hasCover }]}
            transition:animate="fade"
          >
            <slot name="main" />
          </main>
        </>
      )
    }

    <footer class="site-footer">
      <div class="footer-inner">
        <span>在 Notion 写作，由 Astro 发布</span>
        <span aria-hidden="true">·</span>
        <a href={getNavLink('/feed')} data-astro-reload>RSS</a>
        <span aria-hidden="true">·</span>
        <a href="https://ovo7.cc" target="_blank" rel="noreferrer">主站</a>
        <span aria-hidden="true">·</span>
        <a href="mailto:hi@ovo7.cc">hi@ovo7.cc</a>
      </div>
    </footer>

    <SearchModal />
    <NavTransition />
    {
      ENABLE_LIGHTBOX && (
        <script src={getStaticFilePath('/scripts/fslightbox.js')} />
      )
    }
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  .skip-link {
    position: fixed;
    z-index: 200;
    top: 10px;
    left: 10px;
    transform: translateY(-150%);
    border-radius: var(--radius);
    padding: 8px 12px;
    background: var(--ink);
    color: var(--paper);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  /* ===== 站点 chrome（版面尺度见 tufte.css 的 .tufte-body） ===== */
  .site-header {
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }

  .header-inner {
    box-sizing: content-box;
    width: 87.5%;
    max-width: var(--tufte-max);
    margin: 0 auto;
    padding: 1.1rem 0 1.1rem 12.5%;
  }

  /* 顶栏内容与正文栏同宽（--text-width），各页共用，不按页面类型分叉 */
  .header-bar {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  @media (min-width: 761px) {
    .header-bar {
      width: var(--text-width);
    }
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.6rem;
    letter-spacing: 0.02em;
    white-space: nowrap;
    text-decoration: none;
  }

  .brand-logo {
    display: block;
    width: 1.2em;
    height: 1.2em;
    flex-shrink: 0;
    object-fit: contain;
    border-radius: 2px;
  }

  .brand-title {
    line-height: 1.2;
  }

  .site-nav {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 18px;
  }

  .site-nav > a {
    color: var(--muted);
    font-size: 1.1rem;
    cursor: pointer;
  }

  .site-nav > a:hover {
    color: var(--ink);
  }

  .bare-main {
    width: 100%;
    margin: 0;
    padding: 0;
  }

    .page-cover {
    width: 100%;
    height: min(38vh, 280px);
    overflow: hidden;
    background: var(--soft);
  }

  .page-cover picture,
  .page-cover img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .page-cover img {
    object-fit: cover;
    object-position: center 25%;
  }

  /* page-shell 只负责纵向留白；横向尺度由 .tufte-body 决定 */
  .page-shell {
    min-height: calc(100vh - 200px);
    padding-top: 3.5rem;
    padding-bottom: 5rem;
  }

  .page-shell.has-cover {
    min-height: 0;
    padding-top: 2.5rem;
  }

  .site-footer {
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 1rem;
    overflow: visible;
    /* 贴纸落下时页脚要长出托盘，让它长得慢一点，别「啪」地跳一下 */
    transition:
      min-height 420ms ease,
      padding-bottom 420ms ease;
  }

  .site-footer.is-physics-shelf {
    /* 给掉下来的贴纸留一层托盘，免得堆到屏幕外看不见 */
    min-height: 8rem;
    padding-bottom: 3rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer {
      transition: none;
    }
  }

  .footer-inner {
    box-sizing: content-box;
    display: flex;
    width: 87.5%;
    max-width: var(--tufte-max);
    margin: 0 auto;
    padding: 1.4rem 0 1.4rem 12.5%;
    gap: 8px;
    flex-wrap: wrap;
    align-items: baseline;
  }

  /* 首页没有顶栏，页脚跟版心对齐，别再按 Tufte 那 12.5% 栏外注缩进 */
  body:has(.bare-main) .footer-inner {
    box-sizing: border-box;
    width: min(100%, 720px);
    max-width: 720px;
    padding: 1.6rem 28px 2.4rem;
    justify-content: center;
  }

  /* 物理下落时关掉平滑滚动，否则每帧 scrollBy 会被插值叠成乱飘 */
  html.physics-running {
    scroll-behavior: auto;
  }

  /* 物理层里的字 / 贴纸：引擎用 transform 驱动位置 */
  .physics-layer {
    position: absolute;
    z-index: 40;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    overflow: visible;
    pointer-events: none;
  }

  .physics-layer > .is-falling {
    position: absolute;
    left: 0;
    top: 0;
    right: auto;
    bottom: auto;
    margin: 0;
    /* 贴纸本体是 li，脱离 ul 之后会自己长出一个圆点，这里按住 */
    list-style: none;
    transform-origin: center center;
    pointer-events: none;
    will-change: transform;
  }

  /* 颜色与下划线由 sticker-physics 搬家时钉成内联值，这里只放行点击 */
  .physics-layer > a.is-falling {
    pointer-events: auto;
  }

  [data-physics-solid] {
    display: inline-block;
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .header-inner,
    .footer-inner {
      box-sizing: border-box;
      width: 100%;
      padding-left: 5%;
      padding-right: 5%;
    }

    .header-bar {
      width: 100%;
      flex-wrap: wrap;
      row-gap: 8px;
    }

    .site-nav {
      gap: 14px;
    }

    .page-shell {
      padding-left: 5%;
      padding-right: 5%;
      padding-top: 2.5rem;
    }

    .page-cover {
      height: 180px;
    }
  }
</style>
