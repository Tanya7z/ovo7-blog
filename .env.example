# 创建只读 Notion Integration，并把「🗂️ 仓库」分享给它（不是手账本上的「知识」卡片）。
NOTION_API_SECRET=ntn_replace_with_your_read_only_token
# 「🗂️ 仓库」数据库页面
DATABASE_ID=823085de972b4542b1cfdfb9a8a96dfa
# 「🗂️ 仓库」data source（优先用这个拉文章）
DATA_SOURCE_ID=7ab4f37d-daf0-4c80-90ee-9d95b8b2d571

# 「贴画」库（未配置时首页/探索页不展示贴画，不会报错）
# 记得把这个库分享给同一个只读 Integration
STICKER_DATABASE_ID=1be76821452345c8bc7300bdb504be96
STICKER_DATA_SOURCE_ID=532a50aa-76de-481a-a300-ee2516d62ed9
# 贴画库字段默认名：名称 / 图片 / 集合 / 说明 / 角度 / 缩放倍数 / 排序 / 启用
# 其中「缩放倍数」是 Number：1=默认，0.5=一半，2=两倍；空着等同于 1

# 「探索」库：阅读 / 动画 / 电影等收藏条目（未配置时探索页为空，不会报错）
EXPLORE_DATABASE_ID=3bf269b12ce180b8bf0edb1d31dbfb7d
EXPLORE_DATA_SOURCE_ID=3bf269b1-2ce1-80b8-a05f-000bac887819

# 「曲库」：全站左下角常驻的五线谱播放器（未配置时播放器不渲染，不会报错）
# 字段默认名：名称 / 作曲 / 音频 / 排序 / 启用
#   音频 = Files 属性，上传到 Notion 或填外链都行，构建期会把托管文件落到 public/notion/
#   启用 = Checkbox，只播勾上的；排序 = Number，决定播放顺序
MUSIC_DATABASE_ID=
MUSIC_DATA_SOURCE_ID=

CUSTOM_DOMAIN=blog.ovo7.cc
SITE_TITLE=七罪的手账本
SITE_DESCRIPTION=La vida no tiene precio.
SITE_LANGUAGE=zh-CN

# Notion 字段映射；不过滤类型，仓库内全部公开。
# 「类型」在网站上显示为「类目」；「标签」「领域」另有映射。
NOTION_TITLE_PROPERTY=名称
NOTION_SLUG_PROPERTY=
NOTION_DATE_PROPERTY=日期
NOTION_CATEGORIES_PROPERTY=类型
# 兼容旧变量名（等同 NOTION_CATEGORIES_PROPERTY）
# NOTION_TAGS_PROPERTY=类型
NOTION_DOMAINS_PROPERTY=领域
NOTION_LABELS_PROPERTY=标签
NOTION_EXCERPT_PROPERTY=
NOTION_FEATURED_IMAGE_PROPERTY=封面
NOTION_FILTER_PROPERTY=
NOTION_FILTER_VALUE=
NOTION_FILTER_TYPE=select
NOTION_SORT_PROPERTY=创建时间

ENABLE_LIGHTBOX=true