{
  "name": "ovo7-blog",
  "type": "module",
  "version": "0.12.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "dev:mock": "cross-env USE_MOCK_CONTENT=true CUSTOM_DOMAIN= astro dev --mode mock",
    "start": "astro dev",
    "build": "astro build",
    "build:mock": "cross-env USE_MOCK_CONTENT=true CUSTOM_DOMAIN= astro build --mode mock",
    "build:cached": "npm run cache:fetch && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint src",
    "check": "astro check",
    "format": "npx prettier --write .",
    "cache:fetch": "node scripts/blog-contents-cache.cjs",
    "cache:purge": "nx reset && node -e \"require('fs').rmSync('tmp',{recursive:true,force:true})\"",
    "_fetch-notion-blocks": "node scripts/retrieve-block-children.cjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@iconify-json/ph": "^1.2.2",
    "@notionhq/client": "^5.16.0",
    "@supercharge/promise-pool": "^3.2.0",
    "astro": "^7.2.2",
    "astro-icon": "^1.1.5",
    "async-retry": "^1.3.3",
    "dotenv": "^17.4.2",
    "exif-be-gone": "^1.5.1",
    "katex": "^0.16.19",
    "matter-js": "^0.20.0",
    "mermaid": "^11.4.1",
    "metascraper": "^5.45.28",
    "metascraper-description": "^5.45.28",
    "metascraper-image": "^5.45.28",
    "metascraper-title": "^5.45.28",
    "prismjs": "^1.29.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@nrwl/nx-cloud": "^19.1.0",
    "@types/async-retry": "^1.4.9",
    "@types/katex": "^0.16.7",
    "@types/matter-js": "^0.20.2",
    "@types/metascraper": "^5.14.3",
    "@types/metascraper-description": "^5.14.5",
    "@types/metascraper-image": "^5.14.5",
    "@types/metascraper-title": "^5.14.5",
    "@types/prismjs": "^1.26.5",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@typescript-eslint/typescript-estree": "^8.58.0",
    "cli-progress": "^3.12.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.2.0",
    "eslint-plugin-astro": "^1.6.0",
    "nx": "20.3.1",
    "typescript": "^5.9.3"
  },
  "nx": {
    "targets": {
      "_fetch-notion-blocks": {
        "inputs": [
          "!{projectRoot}/**/*",
          "!{projectRoot}/**/.*",
          "!{projectRoot}/**/.*/**/*",
          {
            "env": "DATABASE_ID"
          },
          {
            "env": "DATA_SOURCE_ID"
          }
        ],
        "outputs": [
          "{projectRoot}/tmp"
        ]
      }
    },
    "includedScripts": [
      "_fetch-notion-blocks"
    ]
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.60.1"
  },
  "allowScripts": {
    "sharp@0.35.3": true,
    "nx@20.3.1": true,
    "esbuild@0.28.2": true,
    "re2@1.21.4": true
  }
}
